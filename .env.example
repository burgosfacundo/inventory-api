# Optional Docker / MySQL overrides
# The Docker demo works without creating a .env file.
MYSQL_DATABASE=inventory_db
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory
MYSQL_ROOT_PASSWORD=root

# Application database
# Useful when running the application outside Docker with custom credentials.
DB_USERNAME=inventory
DB_PASSWORD=inventory

# Geoapify
# Required only when running the application outside the demo profile.
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_API_KEY=your-api-key
GEOAPIFY_MIN_CONFIDENCE=0.95
